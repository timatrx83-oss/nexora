# Optional. Leave unset for the built-in local Mentor Engine (default).
# Never prefix the API key with VITE_ or NEXT_PUBLIC_.

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Set to openai only if you want the optional live API path.
# VITE_MENTOR_ENGINE=openai

# Public Supabase settings. Use the anon key only, never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
